<%# Attorney countersign brief: JUD's markdown sections laid out as a titled list of
    label/value rows. The first section (names and fee on the retainer) sits in the
    gold callout under the action. Every fragment goes through MarkdownToHtml. Each row
    stays on one source line so the plain-text part reads one "Label: value" per line. %>
<% es = I18n.locale.to_s.start_with?('es') %>
<% content_for :bennett_attorney_review, 'true' %>
<% content_for :bennett_preview, es ? 'Contrato listo para su revisión y firma.' : 'Retainer ready for attorney review and signature.' %>
<% inline = ->(md) { MarkdownToHtml.call(ReplaceEmailVariables.call(md, submitter:)).to_str.sub(/\A<p>/, '').sub(%r{</p>\z}, '').html_safe } %>
<div class="email-heading email-review-heading" style="margin:0;font:22px/1.4 Georgia,'Times New Roman',serif;color:#001a2d;">
  <%= render 'custom_content', content: brief[:intro], submitter: submitter %>
</div>
<%= render 'bennett_button', label: brief[:label], url: ReplaceEmailVariables.call('{submitter.link}', submitter: submitter) %>
<% last = brief[:sections].size - 1 %>
<% brief[:sections].each_with_index do |lines, index| %>
  <% lead = index.zero? %>
  <% if !lead && index == last && lines.all? { |l| l[:kind] == :text } %>
    <div class="email-muted email-review-section" style="margin-top:26px;font:12px/1.6 Arial,Helvetica,sans-serif;color:#5d6b77;">
      <% lines.each do |l| %><p style="margin:0;"><%= inline.call(l[:text]) %></p><% end %>
    </div>
    <% next %>
  <% end %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:<%= lead ? 0 : 26 %>px;">
    <tr>
      <td class="<%= lead ? 'email-callout ' : '' %>email-review-section" <%= lead ? 'bgcolor="#f6f0e2"'.html_safe : '' %> style="<%= lead ? 'padding:16px 20px 12px;background-color:#f6f0e2;border-left:3px solid #aa8637;' : 'padding:0;' %>">
        <% lines.each_with_index do |l, i| %>
          <% case l[:kind] %>
          <% when :title %>
            <div class="email-accent" style="margin:<%= i.zero? ? 0 : 14 %>px 0 6px;font:bold 11px/1.6 Arial,Helvetica,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#8a6a24;"><%= inline.call(l[:text]) %></div>
          <% when :row %>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="email-rule email-muted" width="142" valign="top" style="width:142px;padding:8px 14px 8px 0;border-top:1px solid <%= lead ? '#e6dbc2' : '#e7e1d4' %>;font:13px/1.5 Arial,Helvetica,sans-serif;color:#5d6b77;"><%= inline.call(l[:label]) %>:&nbsp;</td><td class="email-rule <%= lead ? 'email-heading' : 'email-text' %>" valign="top" style="padding:8px 0;border-top:1px solid <%= lead ? '#e6dbc2' : '#e7e1d4' %>;font:<%= lead ? 'bold 15px' : '15px' %>/1.5 Arial,Helvetica,sans-serif;color:<%= lead ? '#001a2d' : '#263747' %>;"><%= inline.call(l[:text]) %></td></tr></table>
          <% when :note %>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="email-rule email-accent" width="18" valign="top" style="width:18px;padding:9px 0 9px;border-top:1px solid #e7e1d4;font:bold 15px/1.55 Arial,Helvetica,sans-serif;color:#aa8637;">&bull;&nbsp;</td><td class="email-rule email-text" valign="top" style="padding:9px 0;border-top:1px solid #e7e1d4;font:15px/1.55 Arial,Helvetica,sans-serif;color:#263747;"><%= inline.call(l[:text]) %></td></tr></table>
          <% when :link %>
            <p class="email-rule" style="margin:0;padding:10px 0 0;border-top:1px solid #e7e1d4;font:bold 14px/1.5 Arial,Helvetica,sans-serif;"><%= inline.call(l[:text]) %><!-- start text/html --> <span class="email-accent" style="color:#aa8637;">&rarr;</span><!-- end text/html --></p>
          <% else %>
            <p class="email-text" style="margin:<%= i.zero? ? 0 : 8 %>px 0 0;font:15px/1.55 Arial,Helvetica,sans-serif;color:#263747;"><%= inline.call(l[:text]) %></p>
          <% end %>
        <% end %>
      </td>
    </tr>
  </table>
<% end %>
