# syntax=docker/dockerfile:1
# Bennett Legal production image for retainer signing.
#
# The base is the output of DocuSeal's own Dockerfile, built unmodified from
# this fork's source: bennett/docker-bake.hcl passes it in as the "upstream"
# build context. This layer adds only the Bennett runtime pieces. Upstream
# LICENSE and LICENSE_ADDITIONAL_TERMS stay at /app.
FROM upstream

# Take current Alpine security fixes for everything installed. The nightly
# build scans the result and refuses HIGH and CRITICAL findings before publishing.
# Create the folders first: COPY --chmod would give new folders the files'
# 0644, which the runtime user (uid 2000) cannot enter.
RUN apk upgrade --no-cache && install -d -m 0755 /opt/docuseal /etc/docuseal

# Ruby ships a built-in ("default") json gem that trails security fixes
# (CVE-2026-33210 in 2.18.x). Remove it instead of accepting it: the app and
# launch.rb then load the bundle's json from Gemfile.lock. The build fails if
# a plain require 'json' does not resolve to that bundled, patched copy.
RUN ruby -rfileutils -e 'lib, arch = RbConfig::CONFIG.values_at("rubylibdir", "archdir"); \
      FileUtils.rm_rf([File.join(lib, "json.rb"), File.join(lib, "json"), File.join(arch, "json")] + \
                      Dir[File.join(Gem.default_specifications_dir, "json-*.gemspec")])' && \
    ruby -e 'require "json"; spec = Gem.loaded_specs.fetch("json"); \
      abort("json #{spec.version} at #{spec.gem_dir}") unless spec.version >= Gem::Version.new("2.19.2") && \
        spec.gem_dir.start_with?("/usr/local/bundle/") && JSON.generate(ok: true) == %({"ok":true})'

# Public AWS RDS trust anchors (ca-provenance.json), not a private key.
COPY --chmod=0644 rds-global-bundle.pem /etc/docuseal/rds-global-bundle.pem
RUN echo '90a6f1a7978a1b1b096dca6c57511ca48d3b8cf052f8e704baf358f34ea2f21b  /etc/docuseal/rds-global-bundle.pem' | sha256sum -c -
COPY --chmod=0644 launch.rb puma.rb source_check.rb NOTICE.md /opt/docuseal/
# Native page previews use direct signed S3 URLs, bypassing the gateway. Store
# no-store metadata on every uploaded object, including preview/signature assets.
COPY --chmod=0644 storage.yml /app/config/storage.yml
# Never build an image in which a merge dropped a Bennett change.
RUN ruby /opt/docuseal/source_check.rb /app

# The boot cache stays upstream's /app/tmp/cache, a tmpfs in production, so
# it is never stale and never lands in the backed-up attachments volume.
ARG REVISION=unknown
ARG VERSION=unknown
LABEL org.opencontainers.image.title="Bennett Legal DocuSeal" \
      org.opencontainers.image.source="https://github.com/TheHomelessCoder/docuseal" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      com.bennettlegal.docuseal.build="fork/1"
USER 2000:2000
CMD ["ruby", "/opt/docuseal/launch.rb"]
